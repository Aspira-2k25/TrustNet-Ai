# =============================================================================
# TrustNet AI — Master Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your target deployment.
# =============================================================================

# --- General & Environment ---
# Options: dev, test, production
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Authentication & Security ---
# Set to 'true' ONLY in local dev if mock token testing is desired.
# Must be 'false' in production.
ALLOW_MOCK_AUTH=false

# In production, replace with a strong, randomly generated 32+ byte secret.
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed web frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Gateway Connection ---
VITE_API_GATEWAY_URL=http://localhost:8000

# Optional scam evidence ordering; key stays in backend only. Per-scan consent required.
SCAM_OPTIONAL_ANALYSIS_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Service Ports ---
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
SCAN_SERVICE_PORT=8002
IMAGE_SERVICE_PORT=8003
TRUST_ENGINE_PORT=8004
FRONTEND_PORT=5173

# --- Messaging: Apache Kafka (KRaft mode) ---
# For host development use localhost:9094; for Docker internal networking use kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CONSUMER_GROUP_PREFIX=trustnet_
KAFKA_CONSUMER_GROUP=trustnet_image_deepfake_group
KAFKA_CONSUMER_GROUP_TRUST=trustnet_trust_engine_group

# --- Relational Database (PostgreSQL / SQLite dev fallback) ---
POSTGRES_USER=trustnet
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=trustnet_dev
DATABASE_URL=postgresql+asyncpg://trustnet:replace_with_strong_postgres_password@localhost:5432/trustnet_dev

# --- Document Store (MongoDB) ---
MONGO_URL=mongodb://localhost:27017/trustnet_dev
MONGO_HOST_PORT=27017

# --- In-Memory Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO / S3) ---
STORAGE_DIR=./storage_uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_secure_minio_password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_secure_minio_password
MINIO_BUCKET_NAME=trustnet-uploads
MINIO_SECURE=false

# --- Downstream Microservice URLs (Used by API Gateway) ---
AUTH_SERVICE_URL=http://localhost:8001
SCAN_SERVICE_URL=http://localhost:8002
IMAGE_DEEPFAKE_SERVICE_URL=http://localhost:8003
TRUST_ENGINE_SERVICE_URL=http://localhost:8004

# --- Hugging Face AI Integration ---
# Free read token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here
HF_DEEPFAKE_MODEL=dima806/deepfake_vs_real_image_detection
HF_DEEPFAKE_REVISION=29e4cf9efc543845610045f6ba7e88e5cf9d9301
# ViT-only face screening; CNN-based v2 remains an explicit rollback option.
IMAGE_ASSESSMENT_POLICY=image-vit-v3
IMAGE_ALLOW_HOSTED_INFERENCE=false
IMAGE_ALLOW_MODEL_DOWNLOAD=false
# Optional immutable fine-tuned candidate directory and promoted decision policy.
IMAGE_VIT_MODEL_DIR=
IMAGE_VIT_POLICY_FILE=

# Optional experimental whole-image policy: IMAGE_ASSESSMENT_POLICY=image-general-v4
# Existing v3 remains the rollback/default. A key alone never activates uploads.
IMAGE_INFERENCE_BACKEND=local
HF_GENERAL_IMAGE_MODEL=Ateeqq/ai-vs-human-image-detector
HF_GENERAL_IMAGE_REVISION=60e82406916921b823616bee33397baab38af3f0
IMAGE_HOSTED_UPLOAD_ACK=false
IMAGE_GENERAL_FACE_DIAGNOSTIC=false
IMAGE_GENERAL_POLICY_FILE=
# Only required if explicitly choosing the separately registered Organika candidate.
IMAGE_GENERAL_ALLOW_NONCOMMERCIAL=false

# --- API Gateway Configuration ---
GATEWAY_PROXY_TIMEOUT_SECONDS=1800

# --- LM Studio Local Vision AI Integration ---
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen3-vl-4b-thinking
LM_STUDIO_TIMEOUT_SECONDS=1800
LM_STUDIO_MAX_TOKENS=350

# Scam worker is optional; synchronous scans do not require Kafka.
SCAM_SERVICE_URL=http://localhost:8005
SCAM_PORT=8005
PHISHING_SERVICE_URL=http://127.0.0.1:8007
# URL inference is isolated from the existing image/scam environments.
PHISHING_MODEL_MANIFEST=models/phishing_url/checkpoints/regional_recall_v1/manifest.json
PHISHING_KAFKA_ENABLED=false
SCAM_MAX_CONCURRENCY=2
SCAM_TIMEOUT_SECONDS=20
KAFKA_ENABLED=false
ENABLE_KAFKA_CONSUMER=false
WORKER_STATE_DIR=./runtime_state
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
MAX_VIDEO_SIZE_MB=200
VITE_MAX_IMAGE_SIZE_MB=10

SCAM_SERVICE_TIMEOUT_SECONDS=35
