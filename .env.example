# =============================================================================
# TrustNet AI — Master Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your target deployment.
# =============================================================================

# --- General & Environment ---
# Options: dev, test, production
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Authentication & Security ---
# Set to 'true' ONLY in local dev if mock token testing is desired.
# Must be 'false' in production.
ALLOW_MOCK_AUTH=false

# In production, replace with a strong, randomly generated 32+ byte secret.
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed web frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Gateway Connection ---
VITE_API_GATEWAY_URL=http://localhost:8000

# --- Service Ports ---
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
SCAN_SERVICE_PORT=8002
IMAGE_SERVICE_PORT=8003
TRUST_ENGINE_PORT=8004
FRONTEND_PORT=5173

# --- Messaging: Apache Kafka (KRaft mode) ---
# For host development use localhost:9094; for Docker internal networking use kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CONSUMER_GROUP_PREFIX=trustnet_
KAFKA_CONSUMER_GROUP_IMAGE=trustnet_image_deepfake_group
KAFKA_CONSUMER_GROUP_TRUST=trustnet_trust_engine_group

# --- Relational Database (PostgreSQL / SQLite dev fallback) ---
POSTGRES_USER=trustnet
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=trustnet_dev
DATABASE_URL=postgresql+asyncpg://trustnet:replace_with_strong_postgres_password@localhost:5432/trustnet_dev

# --- Document Store (MongoDB) ---
MONGO_URL=mongodb://localhost:27017/trustnet_dev

# --- In-Memory Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO / S3) ---
STORAGE_DIR=./storage_uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_secure_minio_password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_secure_minio_password
MINIO_BUCKET_NAME=trustnet-uploads
MINIO_SECURE=false

# --- Downstream Microservice URLs (Used by API Gateway) ---
AUTH_SERVICE_URL=http://localhost:8001
SCAN_SERVICE_URL=http://localhost:8002
IMAGE_SERVICE_URL=http://localhost:8003
TRUST_ENGINE_URL=http://localhost:8004

# --- Hugging Face AI Integration ---
# Free read token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here
HF_DEEPFAKE_MODEL=dima806/deepfake_vs_real_image_detection

# --- API Gateway Configuration ---
GATEWAY_PROXY_TIMEOUT_SECONDS=1800

# --- LM Studio Local Vision AI Integration ---
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen3-vl-4b-thinking
LM_STUDIO_TIMEOUT_SECONDS=1800
LM_STUDIO_MAX_TOKENS=350
