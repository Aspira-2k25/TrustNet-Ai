{
  "manifest_version": 3,
  "name": "TrustNet Mail \u00e2\u20ac\u201d Local Scam Screening",
  "version": "1.1.0",
  "description": "Click to screen one opened Gmail message through your authenticated local TrustNet API. Email coverage is limited to evaluated collections.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Connect TrustNet",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "extract.js",
        "presentation.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/IBMPlexSans.ttf"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "109"
}
